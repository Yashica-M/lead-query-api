# ──────────────────────────────────────────────────────────
# Lead Query API — Environment Variables
# ──────────────────────────────────────────────────────────

# Copy this file to .env and fill in your values
# cp .env.example .env

# Server port (default: 3000)
PORT=3000

# PostgreSQL connection string
# ─────────────────────────────────────────────────────────
# OPTION 1: Supabase (recommended — free, no install needed)
# 1. Go to supabase.com → New Project
# 2. Settings → Database → Connection string → URI tab
# 3. Copy & paste below (replace [YOUR-PASSWORD] with your DB password)
#
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
#
# OPTION 2: Docker Compose (local)
# DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_leads
#
# OPTION 3: Local PostgreSQL install
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/crm_leads

# Node environment
NODE_ENV=development
